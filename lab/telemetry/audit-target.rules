# Monitor the MCP implementation, its executable, receiver result, and telemetry configuration.
-w /etc/audit/rules.d/99-lab.rules -p wa -k lab_audit_config
-w /etc/fluent-bit/fluent-bit.conf -p wa -k lab_telemetry_config
-w /opt/lab/target/remote_mcp.py -p wa -k lab_target_mcp_config
-w /opt/lab/target/venv/bin/python -p x -k lab_target_mcp_exec
-w /var/log/lab-target/canary-received.jsonl -p wa -k lab_canary_result
