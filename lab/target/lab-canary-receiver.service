[Unit]
Description=Laboratory synthetic canary receiver (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vmtarget
Group=vmtarget
WorkingDirectory=/opt/lab/target
Environment=CANARY_LOG_PATH=/var/log/lab-target/canary-received.jsonl
ExecStart=/opt/lab/target/venv/bin/python /opt/lab/target/canary_receiver.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/lab-target

[Install]
WantedBy=multi-user.target
